# Koneksi Postgres (Neon / Supabase / Vercel Postgres, dsb.)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Kunci penandatangan sesi login. Buat dengan: openssl rand -base64 32
AUTH_SECRET=

# Kunci enkripsi data NIK & No. KK (64 karakter hex). Buat dengan: openssl rand -hex 32
# PENTING: simpan cadangannya. Jika hilang, NIK/KK yang sudah tersimpan tidak bisa dibuka.
DATA_KEY=

# Token Vercel Blob untuk unggah arsip (dibuat otomatis saat Blob store dihubungkan ke proyek)
BLOB_READ_WRITE_TOKEN=

# Hanya dipakai skrip seed untuk membuat akun superadmin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Tautan media sosial (opsional, ikon tampil jika diisi)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
